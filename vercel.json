{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "main.py": {
      "includeFiles": "{backend/**,*.db,outputs/**,data/**,public/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!public/).*)",
      "destination": "/main.py"
    }
  ]
}
